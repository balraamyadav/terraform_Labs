trigger:
- main
- feature/*

pool:
  name: MacBook-Agent-Pool

parameters:
- name: environment
  displayName: Environment
  type: string
  default: dev
  values:
  - dev
  - prod

stages:

# =====================================================
# 1. TFLINT
# =====================================================

- stage: TFLint
  displayName: TFLint

  jobs:
  - job: TFLint
    displayName: Run TFLint

    steps:
    - checkout: self

    - bash: |
        set -e

        echo "================================="
        echo "TFLint Version"
        echo "================================="

        tflint --version

        echo "================================="
        echo "TFLint Init"
        echo "================================="

        tflint --init

        echo "================================="
        echo "Running TFLint"
        echo "================================="

        tflint

      displayName: Run TFLint


# =====================================================
# 2. TFSEC
# =====================================================

- stage: Tfsec
  displayName: Terraform Security Scan

  dependsOn: []

  condition: succeeded()

  jobs:
  - job: Tfsec
    displayName: Run tfsec

    steps:
    - checkout: self

    - bash: |
        set -e

        echo "================================="
        echo "tfsec Version"
        echo "================================="

        tfsec --version

        echo "================================="
        echo "Running tfsec"
        echo "================================="

        tfsec .

      displayName: Run tfsec


# =====================================================
# 3. TERRASCAN
# =====================================================

- stage: Terrascan
  displayName: Terrascan Security Scan

  dependsOn: []

  condition: succeeded()

  jobs:
  - job: Terrascan
    displayName: Run Terrascan

    steps:
    - checkout: self

    - bash: |
        set -e

        cd "$(System.DefaultWorkingDirectory)"

        echo "================================="
        echo "Terrascan Version"
        echo "================================="

        terrascan version

        echo "================================="
        echo "Terraform Files"
        echo "================================="

        find . -maxdepth 1 -type f -name "*.tf" -print

        echo "================================="
        echo "Running Terrascan"
        echo "================================="

        terrascan scan \
          -i terraform \
          -d . \
          --non-recursive

      displayName: Run Terrascan


