# =====================================================
# 4. SUPER LINTER
# =====================================================

- stage: SuperLinter
  displayName: Super Linter

  dependsOn: []

  condition: succeeded()

  jobs:
  - job: SuperLinter
    displayName: Run Super Linter

    steps:
    - checkout: self
      fetchDepth: 0
      persistCredentials: true

    - bash: |
        set -e

        echo "================================="
        echo "Docker Version"
        echo "================================="

        docker --version

        echo "================================="
        echo "Git Branches"
        echo "================================="

        git branch -a

        echo "================================="
        echo "Fetching main branch"
        echo "================================="

        git fetch origin main:refs/remotes/origin/main

        echo "================================="
        echo "Checking main branch"
        echo "================================="

        git branch -a

        echo "================================="
        echo "Terraform Files"
        echo "================================="

        find . -type f -name "*.tf" -print

        echo "================================="
        echo "Pulling Super Linter"
        echo "================================="

        docker pull \
          --platform linux/amd64 \
          ghcr.io/super-linter/super-linter:latest

        echo "================================="
        echo "Running Super Linter"
        echo "================================="

        docker run --rm \
          --platform linux/amd64 \
          -e RUN_LOCAL=true \
          -e DEFAULT_BRANCH=main \
          -e VALIDATE_ALL_CODEBASE=true \
          -e VALIDATE_TERRAFORM=true \
          -e DEFAULT_WORKSPACE=/tmp/lint \
          -v "$(System.DefaultWorkingDirectory):/tmp/lint" \
          ghcr.io/super-linter/super-linter:latest

      displayName: Run Super Linter


# =====================================================
# 5. TERRATEST
# =====================================================

- stage: Terratest
  displayName: Terratest

  dependsOn:
  - TFLint
  - Tfsec
  - Terrascan
  - SuperLinter

  condition: succeeded()

  jobs:
  - job: Terratest
    displayName: Run Terratest

    steps:
    - checkout: self

    - bash: |
        set -e

        echo "================================="
        echo "Go Version"
        echo "================================="

        go version

        cd tests

        echo "================================="
        echo "Downloading Go Dependencies"
        echo "================================="

        go mod download

        echo "================================="
        echo "Running Terratest"
        echo "================================="

        go test -v ./...

      displayName: Run Terratest


# =====================================================
# 6. OPENCOST
# =====================================================

- stage: OpenCost
  displayName: OpenCost

  dependsOn:
  - Terratest

  condition: succeeded()

  jobs:
  - job: OpenCost
    displayName: Run OpenCost

    steps:
    - checkout: self

    - bash: |
        set -e

        echo "================================="
        echo "Docker Version"
        echo "================================="

        docker --version

        echo "================================="
        echo "Pulling OpenCost Image"
        echo "================================="

        docker pull \
          --platform linux/amd64 \
          quay.io/kubecost1/opencost:latest

        echo "================================="
        echo "OpenCost Image"
        echo "================================="

        docker images quay.io/kubecost1/opencost

      displayName: Validate OpenCost Image


# =====================================================
# 7. TERRAFORM PLAN
# =====================================================

- stage: TerraformPlan
  displayName: Terraform Plan

  dependsOn:
  - OpenCost

  condition: succeeded()

  jobs:
  - job: Plan
    displayName: Terraform Plan

    steps:
    - checkout: self

    - bash: |
        set -e

        echo "================================="
        echo "Terraform Version"
        echo "================================="

        terraform version

        echo "================================="
        echo "Terraform Init"
        echo "================================="

        terraform init

      displayName: Terraform Init


    - bash: |
        set -e

        echo "================================="
        echo "Terraform Validate"
        echo "================================="

        terraform validate

      displayName: Terraform Validate


    - bash: |
        set -e

        echo "================================="
        echo "Terraform Plan"
        echo "================================="

        terraform plan -out=tfplan

      displayName: Terraform Plan


    - publish: $(System.DefaultWorkingDirectory)/tfplan
      artifact: terraform-plan

      displayName: Publish Terraform Plan


# =====================================================
# 8. MANUAL APPROVAL
# =====================================================

- stage: ManualApproval
  displayName: Manual Approval

  dependsOn:
  - TerraformPlan

  condition: succeeded()

  jobs:
  - deployment: Approval

    displayName: Production Approval

    environment: terraform-prod

    strategy:
      runOnce:
        deploy:
          steps:

          - script: |
              echo "================================="
              echo "Manual Approval Completed"
              echo "================================="

            displayName: Approval Completed


# =====================================================
# 9. TERRAFORM APPLY
# =====================================================

- stage: TerraformApply
  displayName: Terraform Apply

  dependsOn:
  - ManualApproval

  condition: succeeded()

  jobs:
  - job: Apply
    displayName: Apply Approved Plan

    steps:

    - checkout: self


    - download: current
      artifact: terraform-plan


    - bash: |
        set -e

        echo "================================="
        echo "Terraform Version"
        echo "================================="

        terraform version

        echo "================================="
        echo "Terraform Init"
        echo "================================="

        terraform init

      displayName: Terraform Init


    - bash: |
        set -e

        echo "================================="
        echo "Applying Approved Terraform Plan"
        echo "================================="

        terraform apply \
          -auto-approve \
          "$(Pipeline.Workspace)/terraform-plan/tfplan"

      displayName: Terraform Apply