trigger:
- main
- feature/*

pool:
  name: MacBook-Agent-Pool

parameters:
- name: environment
  displayName: Environment
  type: string
  default: dev
  values:
  - dev
  - prod

stages:

# =====================================================
# 1. TFLINT
# =====================================================
- stage: TFLint
  displayName: TFLint

  jobs:
  - job: TFLint
    displayName: Run TFLint

    steps:
    - checkout: self

    - bash: |
        set -e

        echo "TFLint version:"
        tflint --version

        echo "Initializing TFLint:"
        tflint --init

        echo "Running TFLint:"
        tflint

      displayName: Run TFLint


# =====================================================
# 2. TFSEC
# =====================================================
- stage: Tfsec
  displayName: Terraform Security Scan

  dependsOn:
  - TFLint

  condition: succeeded()

  jobs:
  - job: Tfsec
    displayName: Run tfsec

    steps:
    - checkout: self

    - bash: |
        set -e

        echo "tfsec version:"
        tfsec --version

        echo "Running tfsec:"
        tfsec .

      displayName: Run tfsec


# =====================================================
# 3. TERRASCAN
# =====================================================
- stage: Terrascan
  displayName: Terrascan Security Scan

  dependsOn:
  - TFLint

  condition: succeeded()

  jobs:
  - job: Terrascan
    displayName: Run Terrascan

    steps:
    - checkout: self

    - bash: |
        set -e

        cd "$(System.DefaultWorkingDirectory)"

        echo "Terrascan version:"
        terrascan version

        echo "Terraform files:"
        find . -maxdepth 1 -type f -name "*.tf" -print

        echo "Running Terrascan:"

        terrascan scan \
          -i terraform \
          -d . \
          --non-recursive

      displayName: Run Terrascan


# =====================================================
# 4. SUPER LINTER
# =====================================================
- stage: SuperLinter
  displayName: Super Linter

  dependsOn:
  - TFLint

  condition: succeeded()

  jobs:
  - job: SuperLinter
    displayName: Run Super Linter

    steps:
    - checkout: self

    - bash: |
        set -e

        docker --version

        docker run --rm \
          -e RUN_LOCAL=true \
          -e VALIDATE_TERRAFORM=true \
          -v "$(System.DefaultWorkingDirectory):/tmp/lint" \
          ghcr.io/super-linter/super-linter:slim

      displayName: Run Super Linter


# =====================================================
# 5. TERRATEST
# =====================================================
- stage: Terratest
  displayName: Terratest

  dependsOn:
  - TFLint
  - Tfsec
  - Terrascan
  - SuperLinter

  condition: succeeded()

  jobs:
  - job: Terratest
    displayName: Run Terratest

    steps:
    - checkout: self

    - bash: |
        set -e

        echo "Go version:"
        go version

        cd tests

        echo "Downloading Go dependencies:"
        go mod download

        echo "Running Terratest:"
        go test -v ./...

      displayName: Run Terratest


# =====================================================
# 6. OPENCOST
# =====================================================
- stage: OpenCost
  displayName: OpenCost

  dependsOn:
  - Terratest

  condition: succeeded()

  jobs:
  - job: OpenCost
    displayName: Run OpenCost

    steps:
    - checkout: self

    - bash: |
        set -e

        echo "Checking Docker:"
        docker --version

        echo "Pulling OpenCost:"
        docker pull ghcr.io/super-linter/super-linter:latest

        echo "OpenCost image:"
        docker images quay.io/kubecost1/opencost

      displayName: Run OpenCost


# =====================================================
# 7. TERRAFORM PLAN
# =====================================================
- stage: TerraformPlan
  displayName: Terraform Plan

  dependsOn:
  - Terratest
  - OpenCost

  condition: succeeded()

  jobs:
  - job: Plan
    displayName: Terraform Plan

    steps:
    - checkout: self

    - bash: |
        set -e

        terraform version

        terraform init

      displayName: Terraform Init


    - bash: |
        set -e

        terraform validate

      displayName: Terraform Validate


    - bash: |
        set -e

        terraform plan -out=tfplan

      displayName: Terraform Plan


    - publish: $(System.DefaultWorkingDirectory)/tfplan
      artifact: terraform-plan


# =====================================================
# 8. MANUAL APPROVAL
# =====================================================
- stage: ManualApproval
  displayName: Manual Approval

  dependsOn:
  - TerraformPlan

  condition: succeeded()

  jobs:
  - deployment: Approval

    displayName: Production Approval

    environment: terraform-prod

    strategy:
      runOnce:
        deploy:
          steps:
          - script: |
              echo "Approval completed."
            displayName: Approval Completed


# =====================================================
# 9. TERRAFORM APPLY
# =====================================================
- stage: TerraformApply
  displayName: Terraform Apply

  dependsOn:
  - ManualApproval

  condition: succeeded()

  jobs:
  - job: Apply
    displayName: Apply Approved Plan

    steps:
    - checkout: self


    - download: current
      artifact: terraform-plan


    - bash: |
        set -e

        terraform version

        terraform init

      displayName: Terraform Init


    - bash: |
        set -e

        echo "Applying approved Terraform plan:"

        terraform apply \
          -auto-approve \
          "$(Pipeline.Workspace)/terraform-plan/tfplan"

      displayName: Terraform Apply